<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <NuGetAuditMode>direct</NuGetAuditMode>
    <!--
      One source, one package per Umbraco major: build with -p:UmbracoMajor=18. A 17 build does not run on 18, even
      though the source compiles against both (IContent.PublishedCultures and IContentService.GetById differ in binary).
      The package targets the lowest version of the major on purpose; consumers resolve their own (patched) version.
    -->
    <UmbracoMajor Condition="'$(UmbracoMajor)' == ''">17</UmbracoMajor>
    <UmbracoNextMajor>$([MSBuild]::Add($(UmbracoMajor), 1))</UmbracoNextMajor>
    <TestSiteUmbracoVersion Condition="'$(UmbracoMajor)' == '17'">17.8.0</TestSiteUmbracoVersion>
    <TestSiteUmbracoVersion Condition="'$(UmbracoMajor)' == '18'">18.2.2</TestSiteUmbracoVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageVersion Include="Umbraco.Cms.Core" Version="[$(UmbracoMajor).0.0, $(UmbracoNextMajor).0.0)" />
    <PackageVersion Include="Umbraco.Cms" Version="$(TestSiteUmbracoVersion)" />
  </ItemGroup>

  <ItemGroup Label="Tests">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.0" />
    <PackageVersion Include="Moq" Version="4.20.72" />
  </ItemGroup>

</Project>
