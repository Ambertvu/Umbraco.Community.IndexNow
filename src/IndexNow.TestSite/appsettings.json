{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "IndexNow": "Debug"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ]
  },
  "ConnectionStrings": {
    "umbracoDbDSN": "Data Source=|DataDirectory|/Umbraco.sqlite.db;Cache=Shared;Foreign Keys=True;Pooling=True",
    "umbracoDbDSN_ProviderName": "Microsoft.Data.Sqlite"
  },
  "Umbraco": {
    "CMS": {
      "Unattended": {
        "InstallUnattended": true,
        "UnattendedUserName": "Administrator",
        "UnattendedUserEmail": "admin@example.com",
        "UnattendedUserPassword": "1234567890"
      },
      "Hosting": {
        "Debug": true
      },
      "Imaging": {
        "HMACSecretKey": "aW5kZXhub3ctdGVzdC1zaXRlLW9ubHktbm90LWEtc2VjcmV0LWluZGV4bm93LXRlc3Qtc2l0ZS1vbmx5LWtleQ=="
      }
    }
  },
  "IndexNow": {
    "Key": "indexnow-testsite-key",
    "Endpoint": "http://localhost:60399/__indexnow/mock",
    "BatchDelaySeconds": 2
  }
}