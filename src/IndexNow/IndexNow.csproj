<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <Product>Umbraco.Community.IndexNow</Product>
    <PackageId>Umbraco.Community.IndexNow</PackageId>
    <Title>IndexNow for Umbraco</Title>
    <Description>Tell Bing and the other IndexNow search engines about published, changed, moved and removed Umbraco pages. Works across multiple domains and leaves out noindex pages. No backoffice, no database tables: add the package and a key.</Description>
    <PackageTags>umbraco;umbraco-marketplace;seo;indexnow;bing;search-engines</PackageTags>
    <Authors>Ambert van Unen</Authors>
    <Copyright>$([System.DateTime]::UtcNow.ToString(`yyyy`)) © Ambert van Unen</Copyright>
    <PackageProjectUrl>https://github.com/Ambertvu/Umbraco.Community.IndexNow</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Ambertvu/Umbraco.Community.IndexNow</RepositoryUrl>
    <PackageReadmeFile>README_nuget.md</PackageReadmeFile>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Umbraco.Cms.Core" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="IndexNow.Tests" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\docs\README_nuget.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>
</Project>
